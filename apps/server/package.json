{
  "name": "@app/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "elysia": "^1.4.30",
    "surrealdb": "^2.2.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
