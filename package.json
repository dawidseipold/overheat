{
  "name": "starter",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --parallel --filter './apps/*' dev",
    "dev:web": "bun run --filter @app/web dev",
    "dev:server": "bun run --filter @app/server dev",
    "build": "bun run --filter './apps/*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "clean": "rm -rf apps/*/dist node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
